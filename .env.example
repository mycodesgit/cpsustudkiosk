APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

ENROLL_DB_CONNECTION=mysql
ENROLL_DB_HOST=127.0.0.1
ENROLL_DB_PORT=3306
ENROLL_DB_DATABASE=coasv2_db_enrollment
ENROLL_DB_USERNAME=root
ENROLL_DB_PASSWORD=

SCHED_DB_CONNECTION=mysql
SCHED_DB_HOST=127.0.0.1
SCHED_DB_PORT=3306
SCHED_DB_DATABASE=coasv2_db_schedule
SCHED_DB_USERNAME=root
SCHED_DB_PASSWORD=

SCHOLAR_DB_CONNECTION=mysql
SCHOLAR_DB_HOST=127.0.0.1
SCHOLAR_DB_PORT=3306
SCHOLAR_DB_DATABASE=coasv2_db_scholarship
SCHOLAR_DB_USERNAME=root
SCHOLAR_DB_PASSWORD=

ASSESS_DB_CONNECTION=mysql
ASSESS_DB_HOST=127.0.0.1
ASSESS_DB_PORT=3306
ASSESS_DB_DATABASE=coasv2_db_assessment
ASSESS_DB_USERNAME=root
ASSESS_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
